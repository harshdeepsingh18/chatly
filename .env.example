SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Google Identity Services OAuth 2.0 Web client ID (public client ID, not a client secret).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Generate a long random value for signing session cookies. Keep it private.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: defaults to ./data. Set this to your persistent disk mount path on Render.
DATA_DIR=
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
